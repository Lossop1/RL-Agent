# ── secrets (never commit) ───────────────────────────────────────────────────
# Remote-box SSH credentials, incl. ssh_pass. Only the .example template is tracked.
config/ssh.json
config/ssh_mujoco.json
config/llm.json
config/*.local.json
config/remote_profile.json
.env
.env.*
!.env.example
*.pem
*.ppk
*.p12
*.key
*.crt
id_rsa*
id_dsa*
id_ed25519*
known_hosts

# ── python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.pytest_tmp*/
.mypy_cache/
.venv/
venv/

# ── frontend build output (regenerated by `vite build` → frontend/dist) ──────
node_modules/
locomotion-console-ui/dist/
frontend/dist/

# ── local console state (runtime, machine-specific) ──────────────────────────
# LOCOMOTION_CONSOLE_STATE_ROOT default lives under the system temp dir; if pointed
# into the repo it holds console_config.json / remote_profile.json — keep it out.
locomotion_console_state/
.runtime_logs/
.codegraph/
.claude/
.latest_strategy_backup_path
*.log
*.jsonl
events.out.tfevents.*
*.pt
*.pth
*.ckpt

# ── large immutable training-payload build snapshots ─────────────────────────
autotuner/training_payloads/**/.build/
autotuner/training_payloads/**/dist/*.tar.gz
strategy_backups/**/remote/
strategy_backups/**/*.tar.gz
strategy_backups/

# ── editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/
